      ],
      "_dmarc.cohenholmes.co.uk": [
        "v=DMARC1; p=none; rua=mailto:kaine.cohen@cohenholmes.co.uk"
      ]
    },
    "MX": {
      "cohenholmes.co.uk": ["cohenholmes-co-uk.mail.protection.outlook.com"]
    },
    "CNAME": {
      "selector1._domainkey.cohenholmes.co.uk": "selector1-cohenholmes-co-uk._domainkey.kcprod1.k-v1.dkim.mail.microsoft",
      "selector2._domainkey.cohenholmes.co.uk": "selector2-cohenholmes-co-uk._domainkey.kcprod1.k-v1.dkim.mail.microsoft"
    }
  }
