{
  "site": "https://cohenholmes.co.uk",
  "routes": [
    { "path": "/", "contains": "Kaine Cohen" },
    { "path": "/ca-builder", "contains": "Conditional Access Policy Builder" },
    { "path": "/ai-governance-check", "contains": "AI Governance Readiness Check" },
    { "path": "/mail-auth", "contains": "DMARC builder" },
    { "path": "/writing", "contains": "Writing" },
    { "path": "/api/medium-feed", "json": "posts" },
    { "path": "/this-route-should-not-exist", "status": 404 }
