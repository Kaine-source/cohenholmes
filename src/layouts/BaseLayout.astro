---
interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  noindex?: boolean;
  ogTitle?: string;
  ogDescription?: string;
}

const {
  title,
  description,
  canonicalPath,
  noindex = false,
  ogTitle = title,
  ogDescription = description,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, 'https://cohenholmes.co.uk').href;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/ca-builder', label: 'CA Builder' },
  { href: '/ai-governance-check', label: 'AI Check' },
  { href: '/mail-auth', label: 'Mail Auth' },
  { href: '/blog', label: 'Blog' },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="referrer" content="no-referrer">
<title>{title}</title>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex">}
<link rel="canonical" href={canonicalUrl}>
<meta property="og:type" content="website">
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={ogDescription}>
<meta property="og:url" content={canonicalUrl}>
<meta name="twitter:card" content="summary">
<meta property="og:site_name" content="CohenHolmes">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<slot name="head" />
<style>
  :root{
    --font-display:'Cormorant Garamond', Georgia, serif;
    --font-body:'DM Sans', -apple-system, sans-serif;
    --navy:#0F1E33;
    --navy-deep:#1A1A2E;
    --accent:#C8622A;
    /* Darker than --accent: #C8622A on --cream is ~3.7:1, below the 4.5:1 AA
       threshold for normal-sized text. Use this for body-sized text (links,
       small labels); --accent is fine for large text (headings) and non-text
       uses (borders, backgrounds). */
    --accent-text:#A8501C;
    --cream:#F7F4EF;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{ background:var(--cream); }
  body{
    background:var(--cream);
    color:var(--navy);
    font-family:var(--font-body);
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
    min-height:100vh;
    display:flex;
    flex-direction:column;
  }
  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.001ms !important; transition-duration:0.001ms !important;}
  }

  .wrap{ max-width:820px; margin:0 auto; padding:0 28px; width:100%; }

  header.site{
    background:var(--navy-deep);
    color:var(--cream);
  }
  .pagehead{
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    justify-content:space-between;
    gap:8px 20px;
    padding:20px 0;
  }
  .pagehead .brand{
    font-family:var(--font-display);
    font-size:20px;
    font-weight:600;
    letter-spacing:0.01em;
    color:var(--cream);
    text-decoration:none;
  }
  .pagehead .brand:hover{ color:var(--accent); }
  .subnav{ display:flex; flex-wrap:wrap; gap:20px; }
  .subnav a{
    font-family:var(--font-body);
    font-size:13.5px;
    font-weight:500;
    color:#C9C7D6;
    text-decoration:none;
  }
  .subnav a:hover{ color:var(--accent); }
  .subnav a[aria-current="page"]{ color:var(--cream); }

  main{ flex:1; padding-bottom:80px; }

  h1{
    font-family:var(--font-display);
    font-weight:600;
    font-size:clamp(34px, 5vw, 48px);
    line-height:1.1;
    letter-spacing:-0.01em;
    margin:34px 0 12px;
    color:var(--navy);
  }
  h2{
    font-family:var(--font-display);
    font-weight:600;
    font-size:clamp(24px, 3.2vw, 30px);
    line-height:1.2;
    margin:40px 0 14px;
    color:var(--navy);
  }
  p{ margin:0 0 16px; }
  a{ color:var(--accent-text); }

  footer.site{
    background:var(--navy-deep);
    color:#C9C7D6;
    font-family:var(--font-body);
    font-size:12.5px;
  }
  footer.site .wrap{
    padding:24px 28px;
    display:flex;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:8px;
  }
</style>
</head>
<body>

<header class="site">
  <div class="wrap">
    <div class="pagehead">
      <a class="brand" href="/">CohenHolmes</a>
      <nav class="subnav" aria-label="Sections">
        {navLinks.map(link => (
          <a href={link.href} aria-current={canonicalPath === link.href ? 'page' : undefined}>{link.label}</a>
        ))}
      </nav>
    </div>
  </div>
</header>

<main>
  <div class="wrap">
    <slot />
  </div>
</main>

<footer class="site">
  <div class="wrap">
    <span>CohenHolmes &mdash; Microsoft 365 consultancy</span>
    <span>cohenholmes.co.uk</span>
  </div>
</footer>

</body>
</html>
