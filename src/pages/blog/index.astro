---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout
  title="Blog — CohenHolmes"
  description="Notes on identity, security and the move into AI engineering."
  canonicalPath="/blog"
>
  <meta slot="head" http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; base-uri 'self'; form-action 'self'; object-src 'none'">

  <h1>Blog</h1>
  <p class="lede">
    Notes on identity, security and the move into AI engineering.
    <a class="feed-link" href="/rss.xml">RSS feed</a>
  </p>

  {posts.length === 0 ? (
    <p class="state">Nothing published here yet — check back soon.</p>
  ) : (
    <ul class="posts">
      {posts.map(post => (
        <li class="post">
          <a class="title-link" href={`/blog/${post.data.slug ?? post.id}/`}>
            <span class="post-date">
              {post.data.pubDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}
            </span>
            <h2>{post.data.title}</h2>
          </a>
          <p class="post-desc">{post.data.description}</p>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>

<style>
  .lede{
    font-size:16px;
    color:#4A4A5A;
    max-width:56ch;
    margin-bottom:36px;
  }
  .feed-link{
    margin-left:10px;
    font-size:13px;
    font-weight:500;
    white-space:nowrap;
  }
  .state{
    font-size:14px;
    color:#4A4A5A;
  }
  .posts{
    list-style:none;
    display:flex;
    flex-direction:column;
  }
  .post{
    border-top:1px solid #E3DFD3;
    padding:26px 0;
  }
  .post:last-child{ border-bottom:1px solid #E3DFD3; }
  .title-link{
    text-decoration:none;
    color:var(--navy);
    display:block;
  }
  .title-link h2{ margin:2px 0 8px; }
  .title-link:hover h2{ color:var(--accent); }
  .title-link:focus-visible{ outline:2px solid var(--accent); outline-offset:3px; }
  .post-date{
    font-family:var(--font-body);
    font-size:12px;
    font-weight:500;
    color:#6B6975;
    text-transform:uppercase;
    letter-spacing:0.04em;
  }
  .post-desc{
    font-size:15px;
    color:#3A3A48;
    max-width:64ch;
  }
</style>
