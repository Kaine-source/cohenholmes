---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="AI Governance Readiness Check — CohenHolmes"
  description="A practical, private AI governance readiness check covering data, identity, governance, agents and human oversight."
  canonicalPath="/ai-governance-check"
  ogTitle="AI Governance Readiness Check — CohenHolmes"
  ogDescription="Twelve practical questions. A private, browser-only result. No data submitted or stored."
  wide
>
  <meta slot="head" http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'sha256-Bxiuow0EgCtSifOrfe7d5/IlSlMOeTa+5+HTCEPj98w='; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'">

    <section aria-labelledby="page-title">
      <p class="eyebrow">Practical assessment · 5 minutes</p>
      <h1 id="page-title">How ready are you to govern <em>AI?</em></h1>
      <p class="lede">Twelve questions across data, identity, governance, agents and human oversight. The result is a starting point for a better conversation — not a compliance certificate. You get a score, a breakdown by area, and three next actions to take away and act on yourself. For anything that matters, check it against a real framework — NIST AI RMF, ISO/IEC 42001, the EU AI Act — and get proper advice; this doesn't replace that.</p>
      <div class="privacy">
        <span aria-hidden="true">✓</span>
        <div><strong>Your answers stay in this browser.</strong> No account, analytics, answer submission or browser storage is used by this assessment — this page&rsquo;s Content Security Policy blocks every request to anywhere outside cohenholmes.co.uk, including the anonymous visit-counter used elsewhere on the site &mdash; even its fonts are served from this site, not Google.</div>
      </div>
    </section>

    <form id="assessment" class="assessment" novalidate>
      <noscript><p class="noscript">This assessment needs JavaScript to calculate the result locally in your browser. No answers are sent to a server.</p></noscript>
      <div class="assessment-head">
        <h2>Readiness questions</h2>
        <span id="progress-copy" class="progress-copy">0 of 12 answered</span>
      </div>
      <div class="progress-track" role="progressbar" aria-label="Assessment completion" aria-valuemin="0" aria-valuemax="12" aria-valuenow="0">
        <div id="progress-value" class="progress-value"></div>
      </div>

      <div id="questions"></div>

      <div class="form-actions">
        <button class="button primary" type="submit">Show my readiness</button>
        <button class="button" type="reset">Clear answers</button>
      </div>
      <p id="form-error" class="error" role="alert"></p>
    </form>

    <section id="results" class="results" aria-labelledby="result-title" aria-live="polite">
      <div class="result-card">
        <div class="result-grid">
          <div class="score"><strong id="score-value">0</strong><span> / 24</span></div>
          <div>
            <div id="level-label" class="level">Foundation</div>
            <h2 id="result-title">Your current position</h2>
            <p id="level-description"></p>
          </div>
        </div>
      </div>

      <div class="breakdown">
        <h3>Capability breakdown</h3>
        <div id="domain-breakdown"></div>
      </div>

      <div class="actions-panel">
        <h3>Three useful next actions</h3>
        <ol id="next-actions" class="next-actions"></ol>
        <p class="disclaimer">This lightweight check is educational guidance. It does not test your environment, validate legal compliance or replace a formal risk assessment.</p>
        <div class="result-actions">
          <button id="download" class="button primary" type="button">Download JSON summary</button>
          <button id="print-results" class="button" type="button">Print or save as PDF</button>
          <button id="retake" class="button" type="button">Review answers</button>
        </div>
      </div>
    </section>

  <script is:inline>
  const questions = [
    {
      domain:'Data',
      question:'Can you identify where sensitive organisational data is stored and who can access it?',
      why:'AI can expose permissions and sharing decisions that were previously difficult to notice.',
      action:'Map sensitive data locations, owners and access paths before widening AI access.'
    },
    {
      domain:'Data',
      question:'Are sensitivity, retention and sharing controls applied consistently to important information?',
      why:'Governance needs enforceable controls, not labels that exist only in a policy document.',
      action:'Define a minimum information-protection baseline and measure where it is missing.'
    },
    {
      domain:'Data',
      question:'Can teams explain which data an AI tool used to produce an important answer?',
      why:'Traceability helps people verify outputs and investigate unexpected disclosure.',
      action:'Require source visibility and evidence capture for material AI-assisted decisions.'
    },
    {
      domain:'Identity',
      question:'Do AI services use named identities with least-privilege access rather than shared credentials?',
      why:'Every agent and integration needs an accountable identity and a deliberately limited reach.',
      action:'Inventory agent and service identities, then remove shared or excessive permissions.'
    },
    {
      domain:'Identity',
      question:'Are privileged AI administration activities protected by strong authentication and review?',
      why:'Administrative access can change models, data connections, sharing and external actions.',
      action:'Apply phishing-resistant authentication and time-bound access to AI administration.'
    },
    {
      domain:'Governance',
      question:'Is there a named owner for each production AI use case?',
      why:'Ownership connects business value, technical operation, data responsibility and risk acceptance.',
      action:'Assign one accountable business owner and one technical owner to every production use case.'
    },
    {
      domain:'Governance',
      question:'Do you maintain an inventory of approved AI tools, models, use cases and data connections?',
      why:'An organisation cannot govern systems it cannot identify.',
      action:'Create a living AI inventory covering owners, purpose, data, model and deployment status.'
    },
    {
      domain:'Governance',
      question:'Are AI risks reviewed before launch and again when the model, data or purpose changes?',
      why:'A safe initial assessment becomes stale when the system or its context changes.',
      action:'Introduce lifecycle review triggers for material model, data, permission and purpose changes.'
    },
    {
      domain:'Agents',
      question:'Are agent actions constrained by explicit tools, scopes and approval rules?',
      why:'An agent should not inherit broader capability than the task requires.',
      action:'Separate read, draft, write, share and delete capabilities, with approvals for consequential actions.'
    },
    {
      domain:'Agents',
      question:'Can you test and reconstruct what an agent did, including its inputs, actions and failures?',
      why:'Operational confidence depends on useful logs, evaluations and incident evidence.',
      action:'Capture agent actions and evaluation results in an auditable operational record.'
    },
    {
      domain:'Human oversight',
      question:'Are people told when they must review an AI output before relying on or sharing it?',
      why:'Human review only works when its purpose, threshold and accountable reviewer are clear.',
      action:'Define review thresholds for external communication and decisions with material impact.'
    },
    {
      domain:'Human oversight',
      question:'Can staff report harmful, inaccurate or unexpected AI behaviour through a known process?',
      why:'A visible feedback and incident route turns individual concern into organisational learning.',
      action:'Publish an AI incident route with owners, response targets and feedback to reporters.'
    }
  ];

  const levels = [
    {max:6,label:'Foundation',title:'Start with visibility and ownership',description:'AI activity is likely moving faster than the controls around it. Establish what exists, who owns it and which data or actions create the greatest exposure.'},
    {max:12,label:'Developing',title:'Turn good intentions into a repeatable baseline',description:'Some useful controls exist, but coverage or accountability is uneven. Focus on a minimum standard that every AI use case must meet.'},
    {max:18,label:'Controlled',title:'Connect governance across the lifecycle',description:'Your foundations are credible. The next step is making reviews, evidence and change triggers consistent from discovery through retirement.'},
    {max:22,label:'Operational',title:'Measure whether the controls work',description:'Governance is operating across most areas. Prioritise assurance, evaluation quality and evidence that controls behave as intended in practice.'},
    {max:24,label:'Adaptive',title:'Use evidence to improve continuously',description:'Your answers indicate a mature operating position. Keep testing assumptions, learning from incidents and adapting controls as models and use cases change.'}
  ];

  const questionsEl = document.getElementById('questions');
  const form = document.getElementById('assessment');
  const progressCopy = document.getElementById('progress-copy');
  const progressValue = document.getElementById('progress-value');
  const progressTrack = document.querySelector('.progress-track');
  const formError = document.getElementById('form-error');
  const results = document.getElementById('results');
  let latestSummary = null;

  questions.forEach((item,index) => {
    const fieldset = document.createElement('fieldset');
    const legend = document.createElement('legend');
    const domain = document.createElement('span');
    domain.className = 'domain';
    domain.textContent = item.domain;
    const question = document.createElement('span');
    question.className = 'question';
    question.textContent = `${index + 1}. ${item.question}`;
    const why = document.createElement('span');
    why.className = 'why';
    why.textContent = item.why;
    legend.append(domain,question,why);
    fieldset.appendChild(legend);

    const choices = document.createElement('div');
    choices.className = 'choices';
    [[0,'Not yet'],[1,'Partly'],[2,'Consistently']].forEach(([value,label]) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'choice';
      const input = document.createElement('input');
      input.type = 'radio';
      input.name = `q${index}`;
      input.id = `q${index}-${value}`;
      input.value = value;
      const choiceLabel = document.createElement('label');
      choiceLabel.htmlFor = input.id;
      choiceLabel.textContent = label;
      wrapper.append(input,choiceLabel);
      choices.appendChild(wrapper);
    });
    fieldset.appendChild(choices);
    questionsEl.appendChild(fieldset);
  });

  function getAnswers(){
    return questions.map((_,index) => {
      const checked = form.querySelector(`input[name="q${index}"]:checked`);
      return checked ? Number(checked.value) : null;
    });
  }

  function updateProgress(){
    const answered = getAnswers().filter(value => value !== null).length;
    progressCopy.textContent = `${answered} of ${questions.length} answered`;
    progressValue.style.width = `${(answered / questions.length) * 100}%`;
    progressTrack.setAttribute('aria-valuenow',String(answered));
    if(answered === questions.length) formError.textContent = '';
  }

  function buildSummary(answers){
    const score = answers.reduce((sum,value) => sum + value,0);
    const level = levels.find(item => score <= item.max);
    const domains = {};
    questions.forEach((item,index) => {
      if(!domains[item.domain]) domains[item.domain] = {score:0,max:0};
      domains[item.domain].score += answers[index];
      domains[item.domain].max += 2;
    });
    const actions = questions
      .map((item,index) => ({domain:item.domain,text:item.action,score:answers[index],index}))
      .sort((a,b) => a.score - b.score || a.index - b.index)
      .slice(0,3);
    return {generatedAt:new Date().toISOString(),score,maxScore:questions.length * 2,level,domains,actions};
  }

  function renderResults(summary){
    document.getElementById('score-value').textContent = summary.score;
    document.getElementById('level-label').textContent = summary.level.label;
    document.getElementById('result-title').textContent = summary.level.title;
    document.getElementById('level-description').textContent = summary.level.description;

    const breakdown = document.getElementById('domain-breakdown');
    breakdown.replaceChildren();
    Object.entries(summary.domains).forEach(([name,value]) => {
      const row = document.createElement('div');
      row.className = 'domain-row';
      const label = document.createElement('span');
      label.className = 'domain-name';
      label.textContent = name;
      const bar = document.createElement('div');
      bar.className = 'bar';
      bar.setAttribute('role','img');
      bar.setAttribute('aria-label',`${name}: ${value.score} out of ${value.max}`);
      const fill = document.createElement('span');
      fill.style.width = `${(value.score / value.max) * 100}%`;
      bar.appendChild(fill);
      const score = document.createElement('span');
      score.className = 'domain-score';
      score.textContent = `${value.score} / ${value.max}`;
      row.append(label,bar,score);
      breakdown.appendChild(row);
    });

    const actions = document.getElementById('next-actions');
    actions.replaceChildren();
    summary.actions.forEach(item => {
      const li = document.createElement('li');
      const body = document.createElement('div');
      const text = document.createElement('span');
      text.textContent = item.text;
      const domain = document.createElement('span');
      domain.className = 'action-domain';
      domain.textContent = item.domain;
      body.append(text,domain);
      li.appendChild(body);
      actions.appendChild(li);
    });

    results.classList.add('visible');
    results.scrollIntoView({behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'});
  }

  form.addEventListener('change',updateProgress);
  form.addEventListener('submit',event => {
    event.preventDefault();
    const answers = getAnswers();
    const missing = answers.findIndex(value => value === null);
    if(missing !== -1){
      formError.textContent = `Please answer question ${missing + 1} before viewing your result.`;
      form.querySelector(`input[name="q${missing}"]`).focus();
      return;
    }
    formError.textContent = '';
    latestSummary = buildSummary(answers);
    renderResults(latestSummary);
  });

  form.addEventListener('reset',() => {
    window.setTimeout(() => {
      updateProgress();
      results.classList.remove('visible');
      latestSummary = null;
      formError.textContent = '';
    },0);
  });

  document.getElementById('retake').addEventListener('click',() => {
    form.scrollIntoView({behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'});
  });

  document.getElementById('print-results').addEventListener('click',() => {
    window.print();
  });

  document.getElementById('download').addEventListener('click',() => {
    if(!latestSummary) return;
    const exportData = {
      assessment:'CohenHolmes AI Governance Readiness Check',
      generatedAt:latestSummary.generatedAt,
      score:latestSummary.score,
      maxScore:latestSummary.maxScore,
      level:latestSummary.level.label,
      domainScores:latestSummary.domains,
      nextActions:latestSummary.actions.map(({domain,text}) => ({domain,text})),
      notice:'Educational guidance only; not a compliance assessment.'
    };
    const blob = new Blob([JSON.stringify(exportData,null,2)],{type:'application/json'});
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = 'ai-governance-readiness-summary.json';
    document.body.appendChild(link);
    link.click();
    link.remove();
    URL.revokeObjectURL(url);
  });

  updateProgress();
</script>
</BaseLayout>

<style>
  :root{
    --font-mono:'DM Mono', monospace;
    --card:#FCFAF6;
    --paper-dim:#EDE8DD;
    --line:#E3DFD3;
    --muted:#4A4A5A;
    --good:#237A57;
    --warn:#A65A1F;
  }

  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;}
  .eyebrow{
    margin-bottom:16px;
    font-family:var(--font-mono);
    font-size:.76rem;
    letter-spacing:.12em;
    text-transform:uppercase;
    color:var(--accent-text);
  }
  h1,h2,h3{font-family:var(--font-display);font-weight:480;letter-spacing:-.02em;}
  h1{font-size:clamp(2.45rem,6vw,4.5rem);line-height:1.03;max-width:16ch;}
  h1 em{font-style:italic;font-weight:340;color:var(--accent);}
  .lede{max-width:58ch;margin-top:22px;font-size:clamp(1.05rem,2vw,1.25rem);color:var(--muted);}
  .privacy{
    display:flex;
    gap:12px;
    align-items:flex-start;
    max-width:68ch;
    margin-top:24px;
    padding:16px 18px;
    background:var(--card);
    border:1px solid var(--line);
    border-radius:14px;
    font-size:.92rem;
  }
  .privacy strong{display:block;margin-bottom:2px;}
  .privacy span[aria-hidden="true"]{color:var(--good);font-weight:600;}

  .assessment{margin-top:62px;}
  .assessment-head{
    display:flex;
    justify-content:space-between;
    align-items:end;
    gap:20px;
    padding-bottom:16px;
    border-bottom:1px solid var(--line);
  }
  .assessment-head h2{font-size:clamp(1.65rem,4vw,2.4rem);}
  .progress-copy{font-family:var(--font-mono);font-size:.75rem;color:var(--muted);white-space:nowrap;}
  .progress-track{height:6px;margin:14px 0 34px;background:var(--paper-dim);border-radius:999px;overflow:hidden;}
  .progress-value{height:100%;width:0;background:var(--accent);transition:width .25s ease;}

  :global(fieldset){
    border:0;
    padding:0 0 30px;
    margin:0 0 30px;
    border-bottom:1px solid var(--line);
  }
  :global(legend){width:100%;}
  :global(.domain){
    display:inline-block;
    margin-bottom:8px;
    font-family:var(--font-mono);
    font-size:.7rem;
    letter-spacing:.1em;
    text-transform:uppercase;
    color:var(--accent-text);
  }
  :global(.question){display:block;max-width:64ch;font-size:1.08rem;font-weight:500;line-height:1.48;}
  :global(.why){display:block;max-width:67ch;margin-top:7px;color:var(--muted);font-size:.9rem;}
  :global(.choices){display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:18px;}
  :global(.choice){position:relative;}
  :global(.choice input){position:absolute;opacity:0;pointer-events:none;}
  :global(.choice label){
    display:block;
    height:100%;
    padding:12px 14px;
    border:1px solid var(--line);
    border-radius:12px;
    background:var(--card);
    text-align:center;
    font-size:.9rem;
    transition:border-color .18s ease,background .18s ease,transform .18s ease;
  }
  :global(.choice label:hover){border-color:var(--accent-text);transform:translateY(-1px);}
  :global(.choice input:checked + label){border-color:var(--accent-text);background:#F1E2D6;box-shadow:inset 0 0 0 1px var(--accent);}
  :global(.choice input:focus-visible + label){outline:3px solid rgba(200,98,42,.28);outline-offset:2px;}

  .form-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:8px;}
  .button{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-height:46px;
    padding:11px 18px;
    border:1px solid var(--line);
    border-radius:999px;
    background:var(--cream);
    color:var(--navy);
    font-weight:500;
  }
  .button.primary{background:var(--navy);border-color:var(--navy);color:var(--cream);}
  .button:hover{border-color:var(--accent-text);background:#F1E2D6;}
  .button.primary:hover{background:var(--accent-text);border-color:var(--accent-text);color:#fff;}
  .button:focus-visible{outline:3px solid rgba(200,98,42,.3);outline-offset:2px;}
  .error{min-height:1.5em;margin-top:12px;color:#9C2F2F;font-size:.9rem;}
  .noscript{margin-top:32px;padding:16px 18px;border:1px solid #9C2F2F;border-radius:14px;color:#7E2525;background:#FFF4F2;}

  .results{display:none;margin-top:72px;scroll-margin-top:24px;}
  .results.visible{display:block;}
  .result-card{
    padding:clamp(24px,5vw,42px);
    background:var(--navy);
    color:var(--cream);
    border-radius:20px;
  }
  .result-grid{display:grid;grid-template-columns:minmax(150px,.7fr) 1.5fr;gap:34px;align-items:center;}
  .score{font-family:var(--font-display);font-size:clamp(3.8rem,10vw,6.8rem);line-height:.85;letter-spacing:-.06em;}
  .score span{font-family:var(--font-mono);font-size:.85rem;letter-spacing:0;color:#BFC2CC;}
  .level{font-family:var(--font-mono);font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;color:#AFC0FF;}
  .result-card h2{margin-top:8px;font-size:clamp(1.9rem,5vw,3rem);}
  .result-card p{margin-top:12px;max-width:54ch;color:#CFD1D8;}

  .breakdown,.actions-panel{margin-top:38px;}
  .breakdown h3,.actions-panel h3{font-size:1.5rem;margin-bottom:18px;}
  :global(.domain-row){display:grid;grid-template-columns:135px 1fr 54px;gap:14px;align-items:center;margin:13px 0;}
  :global(.domain-name){font-size:.88rem;}
  :global(.bar){height:8px;background:var(--paper-dim);border-radius:999px;overflow:hidden;}
  :global(.bar span){display:block;height:100%;background:var(--accent);border-radius:inherit;}
  :global(.domain-score){text-align:right;font-family:var(--font-mono);font-size:.75rem;color:var(--muted);}
  .next-actions{list-style:none;display:grid;gap:12px;counter-reset:actions;}
  :global(.next-actions li){
    counter-increment:actions;
    display:grid;
    grid-template-columns:34px 1fr;
    gap:12px;
    padding:17px;
    background:var(--card);
    border:1px solid var(--line);
    border-radius:14px;
  }
  :global(.next-actions li::before){
    content:counter(actions,decimal-leading-zero);
    font-family:var(--font-mono);
    font-size:.72rem;
    color:var(--accent-text);
    padding-top:3px;
  }
  :global(.action-domain){display:block;margin-top:4px;font-family:var(--font-mono);font-size:.68rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);}
  .disclaimer{margin-top:22px;color:var(--muted);font-size:.84rem;max-width:70ch;}
  .result-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px;}

  footer{
    display:flex;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:8px;
    margin-top:76px;
    padding-top:20px;
    border-top:1px solid var(--line);
    color:var(--muted);
    font-family:var(--font-mono);
    font-size:.75rem;
  }

  @media(max-width:640px){
    :global(.choices){grid-template-columns:1fr;}
    :global(.choice label){text-align:left;}
    .result-grid{grid-template-columns:1fr;}
    :global(.domain-row){grid-template-columns:105px 1fr 48px;gap:10px;}
  }
  @media(prefers-reduced-motion:reduce){
    html{scroll-behavior:auto;}
    *{animation-duration:.001ms!important;transition-duration:.001ms!important;}
  }
  @media print{
    .assessment,.form-actions,.result-actions{display:none!important;}
    .results{display:block!important;margin-top:0;}
    .result-card{background:#fff;color:#000;border:2px solid #000;}
    .result-card p,.level{color:#333;}
    .next-actions li{break-inside:avoid;background:#fff;}
  }
</style>
